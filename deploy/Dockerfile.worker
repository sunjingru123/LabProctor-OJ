FROM golang:1.22-bookworm AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/worker ./cmd/worker
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends gcc g++ ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/worker /worker
RUN useradd -r -u 10001 judge
USER judge
ENTRYPOINT ["/worker"]
